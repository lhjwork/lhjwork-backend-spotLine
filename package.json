{
  "name": "spotline-backend-pnpm",
  "version": "1.0.0",
  "description": "Spotline QR-based local connection service backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:db": "node scripts/testConnection.js",
    "seed": "node scripts/seedData.js",
    "create:admin": "node scripts/createAdmin.js",
    "create:spotline-admin": "node scripts/createSpotlineAdmin.js",
    "install:clean": "pnpm install --frozen-lockfile",
    "clean": "rm -rf node_modules pnpm-lock.yaml",
    "reinstall": "pnpm run clean && pnpm install"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "spotline",
    "qr",
    "local",
    "recommendation"
  ],
  "author": "",
  "license": "MIT"
}