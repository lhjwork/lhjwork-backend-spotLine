{
  "name": "spotline-backend-pnpm",
  "version": "1.0.0",
  "description": "Spotline QR-based local connection service backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node -r tsconfig-paths/register src/server.ts",
    "start:prod": "node dist/server.js",
    "postbuild": "echo 'Build completed. Starting server with: node dist/server.js'",
    "render:build": "pnpm install",
    "render:start": "ts-node -r tsconfig-paths/register src/server.ts",
    "dev": "ts-node -r tsconfig-paths/register src/server.ts",
    "dev:watch": "nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
    "test:db": "ts-node -r tsconfig-paths/register src/scripts/testConnection.ts",
    "seed": "ts-node -r tsconfig-paths/register src/scripts/seedData.ts",
    "create:admin": "ts-node -r tsconfig-paths/register src/scripts/createAdmin.ts",
    "create:spotline-admin": "ts-node -r tsconfig-paths/register src/scripts/createSpotlineAdmin.ts",
    "install:clean": "pnpm install --frozen-lockfile",
    "clean": "rmdir /s /q node_modules & del pnpm-lock.yaml & rmdir /s /q dist",
    "reinstall": "pnpm run clean && pnpm install",
    "type-check": "tsc --noEmit",
    "lint": "echo 'Linting not configured yet'",
    "prebuild": "pnpm run clean:dist",
    "clean:dist": "if exist dist rmdir /s /q dist"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.0.2"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "spotline",
    "qr",
    "local",
    "recommendation"
  ],
  "author": "",
  "license": "MIT"
}
