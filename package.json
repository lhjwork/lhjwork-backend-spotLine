{
  "name": "spotline-backend",
  "version": "2.0.0",
  "description": "Spotline QR-based local connection service backend with TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "start:local": "NODE_ENV=development node -r dotenv/config dist/server.js dotenv_config_path=.env.local",
    "dev": "ts-node -r tsconfig-paths/register src/server.ts",
    "dev:local": "NODE_ENV=development ts-node -r dotenv/config -r tsconfig-paths/register src/server.ts dotenv_config_path=.env.local",
    "dev:watch": "nodemon --exec \"ts-node -r tsconfig-paths/register src/server.ts\"",
    "dev:watch:local": "nodemon --exec \"NODE_ENV=development ts-node -r dotenv/config -r tsconfig-paths/register src/server.ts dotenv_config_path=.env.local\"",
    "test:db": "ts-node -r tsconfig-paths/register src/scripts/testConnection.ts",
    "test:db:local": "NODE_ENV=development ts-node -r dotenv/config -r tsconfig-paths/register src/scripts/testConnection.ts dotenv_config_path=.env.local",
    "setup:local": "NODE_ENV=development ts-node -r dotenv/config -r tsconfig-paths/register src/scripts/setupLocalDB.ts dotenv_config_path=.env.local",
    "cleanup:db": "ts-node -r tsconfig-paths/register src/scripts/cleanupDatabases.ts",
    "migrate:data": "ts-node -r tsconfig-paths/register src/scripts/migrateData.ts",
    "seed": "ts-node -r tsconfig-paths/register src/scripts/seedData.ts",
    "demo": "ts-node -r tsconfig-paths/register src/scripts/createDemoData.ts",
    "demo:recommendations": "ts-node -r dotenv/config -r tsconfig-paths/register src/scripts/createDemoRecommendations.ts dotenv_config_path=.env.local",
    "update-admin-emails": "ts-node -r tsconfig-paths/register src/scripts/updateAdminEmails.ts",
    "migrate-store-id": "ts-node -r tsconfig-paths/register src/scripts/migrateToStoreIdStructure.ts",
    "migrate-demo": "ts-node -r tsconfig-paths/register src/scripts/migrateDemoStores.ts",
    "check-structure": "ts-node -r tsconfig-paths/register src/scripts/checkSystemStructure.ts",
    "cleanup-test": "ts-node -r tsconfig-paths/register src/scripts/cleanupTestData.ts",
    "migrate:test-to-spotline": "node scripts/runMigration.js",
    "backup:spotline": "node scripts/backupSpotLineData.js",
    "migrate:test-to-spotline:direct": "node scripts/migrateFromTestToSpotLine.js",
    "admin:check": "node scripts/checkAdminData.js",
    "admin:reset-password": "node scripts/resetAdminPassword.js",
    "admin:test-login": "node scripts/testAdminLogin.js",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist node_modules",
    "prebuild": "rimraf dist",
    "render:build": "pnpm install --no-frozen-lockfile && pnpm run build",
    "render:start": "node dist/server.js",
    "render:debug": "ls -la && ls -la dist && node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.971.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.0.0",
    "mongoose": "^8.0.3",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.7",
    "nodemon": "^3.0.2",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "18.x",
    "pnpm": "9.x"
  },
  "keywords": [
    "spotline",
    "qr",
    "local",
    "recommendation"
  ],
  "author": "",
  "license": "MIT"
}
